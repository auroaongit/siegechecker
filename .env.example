# Copy this file to ".env" and fill in your own values.
# .env is in .gitignore so your secrets never get pushed to GitHub.

# From https://platform.claude.com -> API keys. Used to read names off the photo.
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL. Leave these empty to get stats from R6 Tracker (the default).
# Fill them in to get stats straight from Ubisoft instead - useful if R6 Tracker
# starts blocking the app. Use a SPARE Ubisoft account, not your main.
UBISOFT_EMAIL=
UBISOFT_PASSWORD=

# Only used with a Ubisoft login: which ranked pool to read, "console" or "pc".
PLATFORM_FAMILY=console

# Which account types to try when searching a name, in order.
# psn = PlayStation, uplay = Ubisoft Connect, xbl = Xbox.
LOOKUP_PLATFORMS=psn,uplay,xbl

# Password for the website. Needed if you host it online, so strangers can't
# use your Claude credit. Leave empty when only running it on your home Wi-Fi.
APP_PASSWORD=
